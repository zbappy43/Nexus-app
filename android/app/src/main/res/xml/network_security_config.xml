<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only. System CAs are trusted in release; user-installed CAs only in
  debug builds (for proxy debugging). Certificate pinning for the website host
  is enforced in Dart (SSL_PINS) for native requests and WebView page loads.
  To additionally pin at the Android network-stack level, add a <domain-config>
  with a <pin-set> generated by tools/generate_ssl_pins.sh (see README).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
